<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(HarmonyOSTargetFramework);$(HarmonyOSPlatformTargetFramework)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>HarmonyOS.Bindings</PackageId>
    <Description>C# bindings for HarmonyOS ArkTS components and APIs</Description>
    <PackageTags>arkui;arkts;bindings</PackageTags>
  </PropertyGroup>

  <!-- 过渡态取舍（workload 化前）：桌面 net10.0 目标继续全量定义 HARMONYOS，
       保持 #else 死代码语义与桌面测试资产不变；harmonyos TFM 的 HARMONYOS
       常量由 SDK 按 TargetPlatformIdentifier 自动定义，无需在此声明。 -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(HarmonyOSTargetFramework)'">
    <DefineConstants>$(DefineConstants);HARMONYOS</DefineConstants>
  </PropertyGroup>

  <!-- @ohos.* 服务层生成器位于 tools/api-generator；
       Api/** 生成产物当前全量参与编译。若后续生成器输出暂不可编译，
       需在此重新加入 Compile Remove。 -->
  <ItemGroup>
    <ProjectReference Include="..\HarmonyOS.Maui.Permissions.Abstractions\HarmonyOS.Maui.Permissions.Abstractions.csproj" />
    <ProjectReference Include="..\HarmonyOS.Maui.Permissions\HarmonyOS.Maui.Permissions.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <Import Project="..\HarmonyOS.Maui.Permissions\build\HarmonyOS.Maui.Permissions.targets" />

  <ItemGroup>
    <!-- napi 互操作核心独立成装（对齐 Java.Interop / Mono.Android 分层） -->
    <ProjectReference Include="..\HarmonyOS.Interop\HarmonyOS.Interop.csproj" />
  </ItemGroup>

  <!-- 全量转正（438/438 编译，M2）：GRAYSCALE 已清空，Api/*.cs 全量参与编译，无需 Compile Remove。 -->
  <ItemGroup>
    <!-- Handler 层手势池化复用需要读取 internal 配置（ArkTapGesture.TapCount 等） -->
    <InternalsVisibleTo Include="HarmonyOS.Maui" />
    <!-- 引擎实验层测试需要 internal ctor（RecordingSink 注入）与 DispatchEvent -->
    <InternalsVisibleTo Include="HarmonyEngineTests" />
    <!-- Essentials 装拆分前经 Maui 装 IVT 触达生成类型 internal 成员，拆分后自带条目 -->
    <InternalsVisibleTo Include="HarmonyOS.Essentials" />
    <InternalsVisibleTo Include="app" />
  </ItemGroup>
</Project>
