<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- linux-musl-arm64 NativeAOT shared library -> staged host libs/arm64-v8a/libapp.so。
         平台 TFM：net10.0-harmonyos26.0；平台注册（TargetPlatformSupported 等）由
         microsoft.net.sdk.harmonyos workload 提供，工程内不再内联片段。 -->
    <TargetFramework>net10.0-harmonyos26.0</TargetFramework>
    <RuntimeIdentifier>linux-musl-arm64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- NativeAOT shared library (the host C shim dlopens it) -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <IlcGenerateStackTraceData Condition="'$(Configuration)' == 'Debug'">true</IlcGenerateStackTraceData>

    <OutputType>Library</OutputType>
    <AssemblyName>app</AssemblyName>
    <!-- 应用包名：留空则由 build targets 从工程名推导（com.arktsbinding.<name-lower>）；
         上架/云调试需要登记包名时请在 dotnet new 时使用 bundleId 参数（如 com.example.myapp）。 -->
    <HarmonyBundleId>HarmonyBundleIdValue</HarmonyBundleId>

    <!-- ModuleInitializer registers the app before any export is called; CA2255 does not apply -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
    <!-- IL2104: the HarmonyOS.Maui package intentionally uses reflection-based bridges that are rooted at runtime. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>

    <!-- XAML via Controls buildTransitive targets; SourceGen keeps InitializeComponent AOT-safe -->
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
  </PropertyGroup>

  <ItemGroup>
    <!-- buildTransitive targets ship HarmonyStageHost/HarmonyBuildLibApp/HarmonyBuildHap/HarmonyDeploy/HarmonyRun;
         平台注册与构建 targets 的注入链由 harmonyos workload 提供（未装 workload 时仓库内
         由 Directory.Build.targets fallback 注册）。 -->
    <PackageReference Include="HarmonyOS.Maui" Version="HarmonyPackageVersion" />
    <!-- 必须显式引用：作为传递依赖时 build 资产被 exclude，Crosscompile.targets 不导入，
         Windows 交叉 NativeAOT 会报 Cross-OS native compilation is not supported -->
    <PackageReference Include="PublishAotClang" Version="HarmonyPublishAotClangVersion" />
  </ItemGroup>

</Project>

