<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- linux-musl-arm64 NativeAOT shared library -> staged host libs/arm64-v8a/libapp.so -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-musl-arm64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- NativeAOT shared library (the host C shim dlopens it) -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <IlcGenerateStackTraceData Condition="'$(Configuration)' == 'Debug'">true</IlcGenerateStackTraceData>

    <OutputType>Library</OutputType>
    <AssemblyName>app</AssemblyName>

    <!-- ModuleInitializer registers the app before any export is called; CA2255 does not apply -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>

    <!-- XAML via Controls buildTransitive targets; SourceGen keeps InitializeComponent AOT-safe -->
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
  </PropertyGroup>

  <ItemGroup>
    <!-- buildTransitive targets ship HarmonyStageHost/HarmonyBuildLibApp/HarmonyBuildHap/HarmonyDeploy/HarmonyRun -->
    <PackageReference Include="HarmonyOS.Maui" Version="HarmonyPackageVersion" />
  </ItemGroup>

</Project>

