<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 纯 net10.0：MAUI Controls 的 netstandard 产物提供 VirtualView/Handler 基建，
         平台视图为本仓库 HarmonyOS.Bindings 的 ArkUINodeBase（NativeAOT 友好） -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>HARMONYOS</DefineConstants>
    <!-- CS8766: ViewHandler.PlatformView nullable vs I*Handler.PlatformView non-null (MAUI 官方做法同)
         CS0618: Controls.Frame 在 .NET 9+ 已弃用，推荐 Border，但我们仍需要支持旧 XAML -->
    <NoWarn>$(NoWarn);CS8766;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HarmonyOS.Bindings\HarmonyOS.Bindings.csproj" />
  </ItemGroup>

</Project>
