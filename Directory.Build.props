<!--
  Directory.Build.props：全仓公共属性收敛（LangVersion/常量/TFM）。
  注意：ImplicitUsings 保持各工程自设（HarmonyOS.Bindings/Interop 关闭以保留显式 using 风格，其余开启）。
-->
<Project>

  <PropertyGroup>
    <!-- 统一 .NET 10 / C# 14（preview）：first-class span conversions、extension members、
         null-conditional assignment、field 关键字等在 Binding/Handler 层均有落地 -->
    <LangVersion>preview</LangVersion>
    <!-- 全产品/样本/测试统一 TFM（对齐 dotnet/android 根 props 集中 TFM 的模式） -->
    <HarmonyOSTargetFramework>net10.0</HarmonyOSTargetFramework>
    <!-- 平台 TFM（M3 平台化第一步）：Interop/Bindings 双目标，
         应用/模板工程直接使用该 TFM 消费平台资产 -->
    <HarmonyOSPlatformTargetFramework>net10.0-harmonyos</HarmonyOSPlatformTargetFramework>
    <!-- B0：包版本与公共元数据仅此一处；升版只改这里（各 csproj 不再写 Version）。
         局部覆盖：个别 csproj 可自行设 PackageVersion（MSBuild 后定义覆盖）。 -->
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>ArkTsBinding</Authors>
    <PackageTags>$(PackageTags);harmonyos;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' AND '$(IsPackable)' != 'false'">
    <PackageReference Include="PublishAotClang" />
  </ItemGroup>

</Project>
