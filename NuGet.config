<?xml version="1.0" encoding="utf-8"?>
<!-- 双源：azure.cn 镜像优先（当前网络环境 nuget.org 会被 302 到镜像）+ nuget.org 兜底
     （跨网络环境迁移机器/CI 时避免单源失联导致全量还原失败） -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.azure.cn" value="https://nuget.azure.cn/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
