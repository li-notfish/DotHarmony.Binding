<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>HARMONYOS</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>HarmonyOS.Bindings</PackageId>
    <Version>1.0.0</Version>
    <Authors>ArkTsBinding</Authors>
    <Description>C# bindings for HarmonyOS ArkTS components and APIs</Description>
    <PackageTags>harmonyos;arkui;arkts;bindings;dotnet</PackageTags>
  </PropertyGroup>

  <!-- 旧版生成器产物：缺 using、含非法 CallMethod<void>、`event` 等保留字未转义，待解析器 C API 模式重出后恢复编译 -->
  <ItemGroup>
    <Compile Remove="Api/**/*.cs" />
    <Compile Remove="Components/**/*.cs" />
    <None Include="Api/**/*.cs" />
    <None Include="Components/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="HarmonyOS.Bindings" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
