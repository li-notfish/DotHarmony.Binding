<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>HarmonyOS.Bindings</PackageId>
    <Version>1.0.0</Version>
    <Authors>ArkTsBinding</Authors>
    <Description>C# bindings for HarmonyOS ArkTS components and APIs</Description>
    <PackageTags>harmonyos;arkui;arkts;bindings;dotnet</PackageTags>
  </PropertyGroup>

  <!-- 旧 napi 路线的过期产物（Api/、Components/）已删除；
       @ohos.* 服务层生成器（src/parser/codeGenerator.ts 路线）重出产物时，
       若产物尚不可编译，需在此重新加入 Compile Remove -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HarmonyOS.Bindings" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- 全量转正（438/438 编译，M2）：GRAYSCALE 已清空，Api/*.cs 全量参与编译，无需 Compile Remove。 -->
  <ItemGroup>
    <!-- Handler 层手势池化复用需要读取 internal 配置（ArkTapGesture.TapCount 等） -->
    <InternalsVisibleTo Include="HarmonyOS.Maui" />
    <!-- 引擎实验层测试需要 internal ctor（RecordingSink 注入）与 DispatchEvent -->
    <InternalsVisibleTo Include="HarmonyEngineTests" />
  </ItemGroup>
</Project>
