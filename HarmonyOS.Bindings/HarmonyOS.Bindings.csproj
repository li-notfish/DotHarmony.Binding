<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>HARMONYOS</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>HarmonyOS.Bindings</PackageId>
    <Version>1.0.0</Version>
    <Authors>ArkTsBinding</Authors>
    <Description>C# bindings for HarmonyOS ArkTS components and APIs</Description>
    <PackageTags>harmonyos;arkui;arkts;bindings;dotnet</PackageTags>
  </PropertyGroup>

  <!-- 旧 napi 路线的过期产物（Api/、Components/）已删除；
       @ohos.* 服务层生成器（src/parser/codeGenerator.ts 路线）重出产物时，
       若产物尚不可编译，需在此重新加入 Compile Remove -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HarmonyOS.Bindings" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- 灰度策略：已转正 BatteryInfo, Camera, Connection, DeviceInfo, Display, Fs, GeoLocationManager, Geolocation, Http, Image, Media, Pasteboard, Picker, Preferences, PromptAction, Request, Router, Sensor, Settings, Vibrator, Window（共 21 个）。
       未转正模块默认不参与编译，逐个验证后加入 APPROVED_MODULES。 -->
  <ItemGroup Condition="'$(SkipGeneratedApi)' != 'false'">


  </ItemGroup>
</Project>
