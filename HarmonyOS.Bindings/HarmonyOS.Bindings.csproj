<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>HarmonyOS.Bindings</PackageId>
    <Version>1.0.0</Version>
    <Authors>ArkTsBinding</Authors>
    <Description>C# bindings for HarmonyOS ArkTS components and APIs</Description>
    <PackageTags>harmonyos;arkui;arkts;bindings;dotnet</PackageTags>
  </PropertyGroup>

  <!-- 旧 napi 路线的过期产物（Api/、Components/）已删除；
       @ohos.* 服务层生成器（src/parser/codeGenerator.ts 路线）重出产物时，
       若产物尚不可编译，需在此重新加入 Compile Remove -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HarmonyOS.Bindings" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- 灰度策略：已转正 AppManager, ArrayList, Audio, BatteryInfo, BundleManager, Camera, ColorSpaceManager, CommonEventManager, Convertxml, Curves, DataShare, DataSharePredicates, Deque, DeviceInfo, Display, DisplaySync, Emitter, Font, FormBindingData, FormProvider, Fs, GeoLocationManager, Geolocation, Hash, HashMap, HashSet, HiAppEvent, Hilog, Http, I18n, Image, InputMethod, Intl, LightWeightMap, List, Matrix4, Measure, Media, Mediaquery, Notification, OsAccount, Picker, Power, Preferences, Queue, Radio, RelationalStore, ResourceManager, Screen, ScreenLock, SecurityLabel, Sensor, Settings, Sms, Socket, Stack, Statvfs, Taskpool, Thermal, TreeMap, Uri, Url, UsbManager, Util, Vibrator, Wallpaper, WebSocket, WifiManager, Worker, Zlib（共 70 个）。
       未转正模块默认不参与编译，逐个验证后加入 APPROVED_MODULES。 -->
