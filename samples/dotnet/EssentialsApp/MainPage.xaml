<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialsApp.MainPage"
             Title="Essentials"
             BackgroundColor="LightGray">
    <StackLayout Spacing="12" Padding="12">
        <Label x:Name="TitleLabel"
               Text="Essentials on HarmonyOS"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Label x:Name="DeviceLabel"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Label x:Name="DisplayLabel"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Label x:Name="AppInfoLabel"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Button Text="Clipboard round trip"
                Clicked="OnClipboardClicked" />
        <Label x:Name="ClipboardLabel"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Button Text="Preferences round trip (int/string/DateTime)"
                Clicked="OnPreferencesClicked" />
        <Label x:Name="PreferencesLabel"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Button Text="Battery info + change events"
                Clicked="OnBatteryClicked" />
        <Label x:Name="BatteryLabel"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Button Text="Refresh display info"
                Clicked="OnRefreshDisplayClicked" />
    </StackLayout>
</ContentPage>
