@page "/upload"

<h1>InputFile</h1>

<p>验证 Blazor Hybrid 下的文件上传通道（JS Blob → 分块 → .NET Stream）。</p>

<InputFile OnChange="OnFileSelected" multiple />

@if (_files.Count > 0)
{
    <ul>
        @foreach (var f in _files)
        {
            <li>@f</li>
        }
    </ul>
}

<p class="result">状态：<strong>@_status</strong></p>

@code {
    private readonly List<string> _files = new();
    private string _status = "（未选择文件）";

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            _files.Clear();
            foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
            {
                // 触发 JS 分块读取 → .NET Stream 的真实路径
                await using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                var bytes = ms.ToArray();
                var head = bytes.Length > 0
                    ? Convert.ToHexString(bytes.AsSpan(0, Math.Min(8, bytes.Length)))
                    : "(空)";
                _files.Add($"{file.Name} · {bytes.Length} bytes · head={head}");
            }
            _status = $"成功读取 {_files.Count} 个文件";
        }
        catch (Exception ex)
        {
            _status = $"失败: {ex.GetType().Name}: {ex.Message}";
        }
    }

}
