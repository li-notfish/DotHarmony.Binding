<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HelloApp.SecondPage"
             Title="Second"
             BackgroundColor="#EAF2FB">
    <StackLayout Spacing="12" Padding="12">
        <Label Text="This is the SECOND page"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Label x:Name="VisitLabel"
               Text="not visited yet"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Label x:Name="LifecycleLabel"
               Text="Second: -A / -D"
               HorizontalTextAlignment="Center"
               BackgroundColor="White" Padding="8" />
        <Button Text="&lt; Back to Main"
                Clicked="OnBackClicked" />
    </StackLayout>
</ContentPage>
